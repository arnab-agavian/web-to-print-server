PORT=4000
API_BASE_URL=http://localhost:4000/api
NODE_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://web-to-print-customer-app.vercel.app,https://web-to-print-admin-app.vercel.app

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
SUPABASE_PRODUCTION_BUCKET=production

# Transaction-mode pooler used by the running application.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true"

# Session-mode pooler used by Prisma migrations.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

RESEND_API_KEY=
EMAIL_ENABLED=false
EMAIL_FROM="Digital Heroes <orders@your-domain.example>"
ADMIN_NOTIFICATION_EMAIL=
PAYMENT_WEBHOOK_SECRET=
